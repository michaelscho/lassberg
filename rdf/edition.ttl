<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1584> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1584" ;
    dcterms:bibliographicCitation "Franz Pfeiffer (Hg.), Briefwechsel zwischen Joseph Freiherrn von Laßberg und Ludwig Uhland. Wien 1870, S. 209" ;
    dcterms:source <https://www.digitale-sammlungen.de/en/view/bsb10620870?page=1> ;
    schema1:abstract "Tübingen, den 22. Sept. 1831. Iur. Stud. Fallati, derjenige von meinen Zuhörern, welcher, soweit es seine juridische Studien gestatten, am meisten mit Eifer und Einsicht sich den poetischen Alterthüme" ;
    schema1:dateCreated "1831-09-22" ;
    schema1:inLanguage "de" ;
    schema1:text "Tübingen, den 22. Sept. 1831. Iur. Stud. Fallati, derjenige von meinen Zuhörern, welcher, soweit es seine juridische Studien gestatten, am meisten mit Eifer und Einsicht sich den poetischen Alterthümern der mittleren Zeit widmet, will eine Ferienreise nach Oberschwaben und an den Bodensee machen, wobei er sich in den oberschwäbischen Bibliotheken umzusehen beabsichtigt. Er hat mich gebeten, für den Fall, daß er auch an das andre Ufer des Bodensees käme, ihm einige empfehlende Zeilen an Sie, hochverehrter Freund, mitzugeben, und ich thu es hiemit im Vertrauen auf Ihr vielerprobtes Wohlwollen gegen die jüngern Freunde der vaterländischen Studien. Mit Verehrung und Freundschaft der Ihrige L. Uhland." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1584/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1584/sent> ;
    voc:harrisNumber "2381" ;
    voc:hasFulltext true ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Schiller Nationalmuseum" ;
    voc:repositoryPlace "Marbach am Neckar" ;
    voc:reviewStatus "draft" .

