<https://michaelscho.github.io/lassberg/letter/lassberg-letter-0966> a csvoc:Letter ;
    rdfs:label "lassberg-letter-0966" ;
    dcterms:bibliographicCitation "Johannes Meyer, Briefwechsel zwischen J. von Laszberg und Johann Adam Pupikofer. In: Alemannia 15 (1887), S. 231-88, S. 285" ;
    dcterms:identifier "9'45, 1.1/75.1" ;
    dcterms:source <https://books.google.de/books?id=dXkKAAAAIAAJ> ;
    schema1:abstract "Hochwohlgeborener Herr! Mit herzlichem Dank sende ich Ihnen hiermit Neugart'sches episcopalis Const. und Zapfii Monum. zurück; ich fand sehr viel Belehrung, besonders in dem erstgenannten Werk, und mö" ;
    schema1:dateCreated "1825-02-24" ;
    schema1:inLanguage "de" ;
    schema1:text "Hochwohlgeborener Herr! Mit herzlichem Dank sende ich Ihnen hiermit Neugart'sches episcopalis Const. und Zapfii Monum. zurück; ich fand sehr viel Belehrung, besonders in dem erstgenannten Werk, und möchte mit so vielen Freunden der alten Geschichte wünschen, dass auch der zweite Teil gedruckt würde. Von Zapfii Monum. bitte ich Sie um den zweiten Teil, sowie auch um das Chronicon Peterhusanum. Von altertümlichen Neuigkeiten gelangt, wenn sie so entfernt sind, wenig in des Bischofs Celle. Doch hatte Herr Pfarrer Kirchhofer die Gefälligkeit, mir ein Heft seiner Auszüge mitzuteilen, worin manches wertvolle aus dem 14. und 15. Jahrhundert vorkommt. Die Reimchronik vom Appenzeller Krieg ist Ihnen wahrscheinlich durch den Herausgeber bekannt geworden. Indem ich Sie, hochwohlgeborener, verehrter Herr! meiner ausgezeichneten Hochachtung versichere und Sie um Ihre weitere Gewogenheit bitte, habe ich die Ehre zu sein Hochdero ergebenster Diac. Pupikofer Bischofzell, den 24. Februar 1825." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-0966/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-0966/sent> ;
    csvoc:mentions <https://michaelscho.github.io/lassberg/person/lassberg-correspondent-0179>,
        <https://michaelscho.github.io/lassberg/person/lassberg-correspondent-0307>,
        <https://michaelscho.github.io/lassberg/place/lassberg-place-0025>,
        <https://michaelscho.github.io/lassberg/work/lassberg-literature-0011>,
        <https://michaelscho.github.io/lassberg/work/lassberg-literature-0012>,
        <https://michaelscho.github.io/lassberg/work/lassberg-literature-0016>,
        <https://michaelscho.github.io/lassberg/work/lassberg-literature-0068> ;
    voc:harrisNumber "2043" ;
    voc:hasFulltext true ;
    voc:publicationStatus "online_print" ;
    voc:repositoryInstitution "Staatsarchiv Thurgau" ;
    voc:repositoryPlace "Frauenfeld" ;
    voc:reviewStatus "published" .

