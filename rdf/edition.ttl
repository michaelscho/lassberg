<https://michaelscho.github.io/lassberg/letter/lassberg-letter-2025> a csvoc:Letter ;
    rdfs:label "lassberg-letter-2025" ;
    dcterms:bibliographicCitation "Johannes Meyer, Briefwechsel zwischen J. von Laszberg und Johann Adam Pupikofer. In: Alemannia 15 (1887), S. 231-88, S. 278" ;
    dcterms:identifier "Ms BRH 46/5" ;
    dcterms:source <https://books.google.de/books?id=dXkKAAAAIAAJ> ;
    schema1:abstract "Eppishausen am 2. Juni 1838. Mit vielem Dank für die freundliche Enthebung meiner eingegangenen Verbindlichkeit, sende ich Ihnen, lieber Freund und Nachbar, die Eppishausen betreffenden Papiere zurück" ;
    schema1:dateCreated "1838-06-02" ;
    schema1:inLanguage "de" ;
    schema1:text "Eppishausen am 2. Juni 1838. Mit vielem Dank für die freundliche Enthebung meiner eingegangenen Verbindlichkeit, sende ich Ihnen, lieber Freund und Nachbar, die Eppishausen betreffenden Papiere zurück. Sie haben mir damit einen Stein vom Herzen genommen; denn nichts kommt mich so schwer an, als ein Versprechen unerfüllt zu lassen. Wir erwarten nächsten Mittwoch einen Besuch, der wohl mehrere Tage bleiben und meine ganze Zeit in Anspruch nehmen wird. Oberstleutnant von Laßberg mit Frau und Nichte kommt von Neuburg an der Donau aus Bayern, eigens um meine und der Meinigen Bekanntschaft zu machen; da muss ich denn auch dem so dringenden und drängenden Geschäft des Einpackens auf einige Zeit entsagen. Empfehlen Sie uns den Ihren, Scherbs und unserem guten Imhof, freundlichst von uns allen gegrüßt und Gott befohlen, von Ihrem ergebensten J. v. Laßberg" ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-2025/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-2025/sent> ;
    voc:harrisNumber "993" ;
    voc:hasFulltext true ;
    voc:journalNumber "140" ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Stadtbibliothek" ;
    voc:repositoryPlace "Winterthur" ;
    voc:reviewStatus "draft" .

