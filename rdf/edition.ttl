<https://michaelscho.github.io/lassberg/letter/lassberg-letter-2277> a csvoc:Letter ;
    rdfs:label "lassberg-letter-2277" ;
    dcterms:bibliographicCitation "Franz Pfeiffer (Hg.), Briefwechsel zwischen Joseph Freiherrn von Laßberg und Ludwig Uhland. Wien 1870, S. 244" ;
    dcterms:source <https://www.digitale-sammlungen.de/en/view/bsb10620870?page=1> ;
    schema1:abstract "Auf der alten Meersburg am 23. Octbrs. 1841. Verertester Freund! Nach in Constanz und St. Gallen angestellten Nachforschungen, kam endlich gestern Abends Ire Reisekarte in meine Hände und hier folgt d" ;
    schema1:dateCreated "1841-10-23" ;
    schema1:inLanguage "de" ;
    schema1:text "Auf der alten Meersburg am 23. Octbrs. 1841. Verertester Freund! Nach in Constanz und St. Gallen angestellten Nachforschungen, kam endlich gestern Abends Ire Reisekarte in meine Hände und hier folgt dieselbe, weil ich doch warscheinlich so bald nicht etwas an Sie zu schiken habe, und den Brief, der Inen Kunde von dem Wiederfinden derselben gibt, doch nicht allein laufen lassen will. Nochmals, lieber Freund! meinen herzlichen Dank für Tren, obwol kurzen, Besuch. Ich habe nun auch des Klein - Heinzelin von Costenz kleines Gedicht vom Ritter und Pfaffen in die Drukerei gegeben, damit es den beiden andern schwäbischen Dichtern Silberdrat und Dettinger beigefügt werde, und die drei redliche Schwaben auf Neuiar in meinem Namen meine Freunde begrüßen. Mögen Sie gesund und vergnügt wieder bei Frer lieben Frau Emma angekommen sein, die wir alle, so wie auch Sie von ganzem Herzen grüßen. Ir I. v. Laßberg." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-2277/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-2277/sent> ;
    voc:harrisNumber "1147" ;
    voc:hasFulltext true ;
    voc:journalNumber "271" ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Schiller Nationalmuseum" ;
    voc:repositoryPlace "Marbach am Neckar" ;
    voc:reviewStatus "draft" .

