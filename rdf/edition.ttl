<https://michaelscho.github.io/lassberg/letter/lassberg-letter-0841> a csvoc:Letter ;
    rdfs:label "lassberg-letter-0841" ;
    dcterms:bibliographicCitation "Franz Pfeiffer (Hg.), Briefwechsel zwischen Joseph Freiherrn von Laßberg und Ludwig Uhland. Wien 1870, S. 32" ;
    dcterms:source <https://www.digitale-sammlungen.de/en/view/bsb10620870?page=1> ;
    schema1:abstract "Hochwohlgeborner Stuttgart, den 20. Mai 1823, Hochzuverehrender Herr Baron! Zu Ende dieses Monats gedenke ich eine Fußreise nach dem Bodensee und nach St. Gallen anzutreten. Da mir so sehr daran geleg" ;
    schema1:dateCreated "1823-05-20" ;
    schema1:inLanguage "de" ;
    schema1:text "Hochwohlgeborner Stuttgart, den 20. Mai 1823, Hochzuverehrender Herr Baron! Zu Ende dieses Monats gedenke ich eine Fußreise nach dem Bodensee und nach St. Gallen anzutreten. Da mir so sehr daran gelegen, Eu. Hochwohlgeboren nicht abermals zu verfehlen, so erlaube ich mir die Anfrage, ob Sie um jene Zeit Ihren Aufenthalt in Eppishausen, oder etwa noch in Constanz haben werden, wo Sie, wie mir Herr Prof. Conz gesagt, den Winter zugebracht? Ueber meine gegenwärtige Beschäftigung mit der altdeutschen Literatur würde ich nicht unterlassen, Ihnen einige Nachricht zu geben, wenn ich nicht die Hoffnung hätte, solches auf meiner Reise mündlich thun zu können. Mit der vorzüglichsten Hochachtung verharre ich Euer Hochwohlgeboren gehorsamster Diener L. Uhland." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-0841/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-0841/sent> ;
    voc:harrisNumber "1978" ;
    voc:hasFulltext true ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Schiller Nationalmuseum" ;
    voc:repositoryPlace "Marbach am Neckar" ;
    voc:reviewStatus "draft" .

<https://michaelscho.github.io/lassberg/letter/lassberg-letter-0842> a csvoc:Letter ;
    rdfs:label "lassberg-letter-0842" ;
