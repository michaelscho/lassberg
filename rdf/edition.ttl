<https://michaelscho.github.io/lassberg/letter/lassberg-letter-0864> a csvoc:Letter ;
    rdfs:label "lassberg-letter-0864" ;
    dcterms:bibliographicCitation "Carl Ritter, Briefwechsel zwischen Joseph Freiherrn von Lassberg und Johann Caspar Zellweger. St.Gallen 1889, S. 33" ;
    dcterms:identifier "Fa Zellweger 40/C 01, Bd. 4, S. 282-285" ;
    dcterms:source <https://books.google.de/books?id=KIHHQBvr1nkC> ;
    schema1:dateCreated "1823-10-13" ;
