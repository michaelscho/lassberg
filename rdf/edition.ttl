<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1158> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1158" ;
    dcterms:bibliographicCitation "Carl Ritter, Briefwechsel zwischen Joseph Freiherrn von Lassberg und Johann Caspar Zellweger. St.Gallen 1889, S. 88" ;
