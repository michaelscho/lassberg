<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1205> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1205" ;
    dcterms:bibliographicCitation "Johannes Meyer, Briefwechsel zwischen J. von Laszberg und Johann Adam Pupikofer. In: Alemannia 16 (1888), S. 1-32 und 97-154, S. 17" ;
    dcterms:identifier "9'45, 1.1/75.1" ;
    dcterms:source <https://books.google.de/books?id=XWY5AAAAMAAJ> ;
    schema1:abstract "Hochwohlgeborener Herr und Gönner! Die Witterung ist zu streng, als dass ich mit meinen halb kranken Zähnen an Eppishausen denken und durch den Schnee waten dürfte. Wie sehr mir dies leid tut, können " ;
    schema1:dateCreated "1827-11-22" ;
    schema1:inLanguage "de" ;
    schema1:text "Hochwohlgeborener Herr und Gönner! Die Witterung ist zu streng, als dass ich mit meinen halb kranken Zähnen an Eppishausen denken und durch den Schnee waten dürfte. Wie sehr mir dies leid tut, können Sie am besten erwägen, da auch Sie wohl schon das unangenehme Gefühl empfunden haben, Ihre Gedanken über Lieblingsbeschäftigungen nicht mitteilen zu können. Für einige früher gebundene Schriften und für die hier mitfolgenden fordert der Buchbinder 53 xr. Das mitkommende Heft der Helvetia hat manche interessante Notiz, doch freilich mehr über die neuere Geschichte. Der Waldmannsche Handel und seine Folgen liegen nun ziemlich offen da. In der Hoffnung, dass Sie mir mein langes Ausbleiben nicht übel deuten, und Ihrem gütigen Andenken mich empfehlend, bin ich Ihr Diac. Pupikofer. Am Tage der Sängerin Cäcilie 27." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1205/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1205/sent> ;
    voc:harrisNumber "2192" ;
    voc:hasFulltext true ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Staatsarchiv Thurgau" ;
    voc:repositoryPlace "Frauenfeld" ;
    voc:reviewStatus "draft" .

