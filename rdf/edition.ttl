        <https://michaelscho.github.io/lassberg/person/lassberg-correspondent-0362>,
        <https://michaelscho.github.io/lassberg/person/lassberg-correspondent-0605>,
        <https://michaelscho.github.io/lassberg/person/lassberg-correspondent-0606>,
        <https://michaelscho.github.io/lassberg/place/lassberg-place-0053>,
        <https://michaelscho.github.io/lassberg/place/lassberg-place-0075>,
        <https://michaelscho.github.io/lassberg/place/lassberg-place-0086>,
        <https://michaelscho.github.io/lassberg/place/lassberg-place-0101> ;
    voc:facsimileUrl <https://dls.staatsarchiv.bs.ch/records/416589/4186313/preview> ;
