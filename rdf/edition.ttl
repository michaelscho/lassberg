<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1733> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1733" ;
    dcterms:bibliographicCitation "Johannes Meyer, Briefwechsel zwischen J. von Laszberg und Johann Adam Pupikofer. In: Alemannia 16 (1888), S. 1-32 und 97-154, S. 139" ;
    dcterms:identifier "9'45, 1.1/75.1" ;
    dcterms:source <https://books.google.de/books?id=XWY5AAAAMAAJ> ;
    schema1:abstract "Herrn Baron von Laßberg zu Eppishausen. Mein hochverehrter Herr und Nachbar! Die Anlage sendet mir Herr Mörikefer zu Ihren Händen. Ich wollte sie Ihnen gestern selbst überbringen, allein die Witterung" ;
    schema1:dateCreated "1833-07-16" ;
    schema1:inLanguage "de" ;
    schema1:text "Herrn Baron von Laßberg zu Eppishausen. Mein hochverehrter Herr und Nachbar! Die Anlage sendet mir Herr Mörikefer zu Ihren Händen. Ich wollte sie Ihnen gestern selbst überbringen, allein die Witterung war gar zu schlecht. Heute reise ich nach Frauenfeld, künftigen Montag auf den Rigi, und so kann ich kaum am Freitag Abend vom Märzenkopf aus, wo ich Inspektion halte, Ihre Aufträge in Eppishausen nach Einsiedeln oder Luzern und Zürich abholen. Sollte die Witterung am Freitag zu ungünstig sein, so senden Sie Ihre eventuellen Depeschen gefälligst durch den Boten. Mit herzlicher Ergebenheit bin ich stets Ihr Diac. Pupikofer. Bischofzell, 16. Juli 1833." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1733/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1733/sent> ;
    voc:harrisNumber "2470" ;
    voc:hasFulltext true ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Staatsarchiv Thurgau" ;
    voc:repositoryPlace "Frauenfeld" ;
    voc:reviewStatus "draft" .

