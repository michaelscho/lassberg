        <https://michaelscho.github.io/lassberg/work/lassberg-literature-0121>,
        <https://michaelscho.github.io/lassberg/work/lassberg-literature-0145> ;
    voc:facsimileUrl <https://dls.staatsarchiv.bs.ch/records/416589/4186313/preview> ;
