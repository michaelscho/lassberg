<https://michaelscho.github.io/lassberg/letter/lassberg-letter-0959> a csvoc:Letter ;
    rdfs:label "lassberg-letter-0959" ;
    dcterms:bibliographicCitation "Carl Ritter, Briefwechsel zwischen Joseph Freiherrn von Lassberg und Johann Caspar Zellweger. St.Gallen 1889, S. 59-62" ;
    dcterms:identifier "Ms BRH 513/91" ;
