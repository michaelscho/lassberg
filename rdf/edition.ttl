<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1368> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1368" ;
    dcterms:bibliographicCitation "Franz Pfeiffer, Zur Geschichte der deutschen Philologie. Briefe an Joseph Freiherrn von Laßberg. Postum hg. von Joseph Maria Wagner. In: Germania 13 (1868), S. 118-27, 244-49, 365-84 und 487-508, S. 369" ;
    dcterms:source <https://upload.wikimedia.org/wikipedia/commons/a/a8/Germania_13_1868.pdf> ;
