<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1274> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1274" ;
    dcterms:bibliographicCitation "Johannes Meyer, Briefwechsel zwischen J. von Laszberg und Johann Adam Pupikofer. In: Alemannia 16 (1888), S. 1-32 und 97-154, S. 29" ;
    dcterms:identifier "9'45, 1.1/75.1" ;
    dcterms:source <https://books.google.de/books?id=XWY5AAAAMAAJ> ;
    schema1:abstract "Hochwohlgeborener Herr und Gönner! Da ich einen Pack Bücher von Ihnen erwartete und dieser nicht angekommen ist, so bin ich etwas unruhig geworden; nicht etwa deswegen, weil ich der Bücher sehr bedürf" ;
    schema1:dateCreated "1829-01-17" ;
    schema1:inLanguage "de" ;
    schema1:text "Hochwohlgeborener Herr und Gönner! Da ich einen Pack Bücher von Ihnen erwartete und dieser nicht angekommen ist, so bin ich etwas unruhig geworden; nicht etwa deswegen, weil ich der Bücher sehr bedürfte, sondern weil ich befürchte, Sie könnten von einem Rückfall betroffen und wieder krank geworden sein. Doch vielleicht sind Sie nach Heiligenberg verreist, durch Gäste gehindert oder über eine neue Entdeckung im alten Bardenhain so versessen, dass Sie den armen Diakon an der Sitter ganz vergessen haben. Dass ich weder so glücklich in Entdeckungen, noch so vergesslich bin, sollen Ihnen mitkommende Schriften beweisen. Das alte Zürich hat, wie ich hoffe, auch für Sie manches bemerkenswerte; die Helvetia und das St. Gallische Neujahrsblatt sind Fortsetzungen. Für den Gebrauch der Müllerschen Altertümer bin ich Ihnen sehr dankbar; sie dienten mir teilweise als Erläuterung zum alten Zürich. Sollte das Appenzellische Landbuch nicht auch Beiträge für Herrn Grimm enthalten? Mit Grimms Altertümern bin ich bald fertig; dass so viele mir unverständliche nordische Stellen angeführt und nicht übersetzt sind, verdrießt mich nicht selten. Leben Sie wohl und gedenken Sie zuweilen Ihres Pupikofer. Bischofzell, den 17. Januar 1829." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1274/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1274/sent> ;
    voc:harrisNumber "2230" ;
    voc:hasFulltext true ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Staatsarchiv Thurgau" ;
    voc:repositoryPlace "Frauenfeld" ;
    voc:reviewStatus "draft" .

