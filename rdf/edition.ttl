<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1826> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1826" ;
    dcterms:bibliographicCitation "Johannes Meyer, Briefwechsel zwischen J. von Laszberg und Johann Adam Pupikofer. In: Alemannia 15 (1887), S. 231-88, S. 273" ;
    dcterms:identifier "Ms BRH 46/5" ;
    dcterms:source <https://books.google.de/books?id=dXkKAAAAIAAJ> ;
    schema1:abstract "Seiner Wohlwürden Herrn Diacon Pupikofer zu Bischofszell. Eppishausen am 1. Januar 1836. Prosit Neujahr! Da bekanntlich das castrum doloris, sonst auch Ofen genannt, in dem hinteren und respektiven ob" ;
    schema1:dateCreated "1836-01-01" ;
    schema1:inLanguage "de" ;
    schema1:text "Seiner Wohlwürden Herrn Diacon Pupikofer zu Bischofszell. Eppishausen am 1. Januar 1836. Prosit Neujahr! Da bekanntlich das castrum doloris, sonst auch Ofen genannt, in dem hinteren und respektiven oberen Speisezimmer, lange zuvor geheizt werden muss, ehe es eine warme Stube macht; so geschieht an dieser Stelle im Namen des frommen und löblichen Gynäcáums zu Eppishausen die geziemende Anfrage: ob unsere lieben Nachbarn, die Episcopicellenses, morgen kommen werden, das Fest des heiligen Berthold in unserem armen Klösterlein mit uns zu feiern? In Erwartung einer erfreulichen Antwort, hat meine Frau bereits ein halb Klafter Holz in den Fornax werfen lassen, auf dass Sadrach, Mysach und Abdenago morgen lobsingend darin herumspazieren können. In fröhlicher Erwartung die beiden Häuser Scherb & Pupikofer morgen persönlich grüßen zu dürfen. Semper idem Laßbergius." ;
    csvoc:hasCorrespAction <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1826/received>,
        <https://michaelscho.github.io/lassberg/letter/lassberg-letter-1826/sent> ;
    voc:harrisNumber "888" ;
    voc:hasFulltext true ;
    voc:journalNumber "1" ;
    voc:publicationStatus "preview_print" ;
    voc:repositoryInstitution "Stadtbibliothek" ;
    voc:repositoryPlace "Winterthur" ;
    voc:reviewStatus "draft" .

