<https://michaelscho.github.io/lassberg/letter/lassberg-letter-1574> a csvoc:Letter ;
    rdfs:label "lassberg-letter-1574" ;
    dcterms:bibliographicCitation "R. Ehwald, Emil Brauns Briefwechsel mit den Brüdern Grimm und Joseph von Laßberg. Gotha 1891, S. 96-100" ;
    dcterms:source <https://books.google.de/books?id=0sUMAQAAIAAJ> ;
